# Copy this file to .env and adjust values for your environment.
# settings.py reads these via os.environ with safe development defaults,
# so the project still boots without a .env file present.

# Django secret key. Generate a new one for any non-local environment, e.g.:
#   uv run python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-nvzqiickm&8ym!ry07-3gfj7jz0_1&jm53q5(=+6kazy!my2)*

# 'True' for local development, 'False' in production.
DEBUG=True

# Comma-separated list of allowed hostnames. Required (non-empty) when DEBUG=False.
ALLOWED_HOSTS=localhost,127.0.0.1
